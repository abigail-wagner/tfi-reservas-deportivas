{
  "expo": {
    "name": "Reservas Villaguay",
    "slug": "reservas-deportivas-villaguay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reservasvillaguay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0284c7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.edu.uner.reservasvillaguay",
      "infoPlist": {
        "NSCameraUsageDescription": "Permiso para escanear el código QR de reservas en el complejo.",
        "NSPhotoLibraryUsageDescription": "Permiso para adjuntar fotos de evidencia de mantenimiento o clima adverso.",
        "NSLocationWhenInUseUsageDescription": "Permiso para calcular la distancia a los complejos deportivos de Villaguay y ordenar las canchas más cercanas.",
        "NSFaceIDUsageDescription": "Permiso para iniciar sesión rápidamente con datos biométricos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0284c7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "ar.edu.uner.reservasvillaguay",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permiso para escanear el código QR de reservas en el complejo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permiso para adjuntar fotos de evidencia de mantenimiento o clima adverso."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permiso para calcular la distancia a los complejos deportivos de Villaguay y ordenar las canchas más cercanas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0284c7",
          "sounds": []
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permiso para iniciar sesión rápidamente con datos biométricos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0284c7"
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f13e77ad-e8f6-4097-ba1d-03b958b2ad45"
      }
    },
    "owner": "abigailwag18"
  }
}
